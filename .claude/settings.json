{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "harna hook post-edit",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "harna hook pre-bash",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "harna hook session-start",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "harna hook stop",
            "type": "command"
          }
        ]
      }
    ]
  }
}
